
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share

DEFAULT_URI=http://localhost

DATABASE_URL="postgresql://app:app@database:5432/app?serverVersion=16&charset=utf8"

###> symfony/messenger ###
# Fila do RabbitMQ (serviço "rabbitmq" do docker-compose)
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@rabbitmq:5672/%2f/messages
###< symfony/messenger ###

# Segredo do webhook do WooCommerce: o mesmo valor configurado no WooCommerce
# (WooCommerce > Configurações > Avançado > Webhooks > Segredo).
# Valor de desenvolvimento; em produção, defina o valor real em .env.local ou numa variável de ambiente.
WOOCOMMERCE_WEBHOOK_SECRET=dev-webhook-secret

###> autenticação ###
# Validade do token de acesso emitido no login, em segundos (28800 = 8 horas)
AUTH_TOKEN_TTL=28800
# Usuário padrão criado pelo seeder: php bin/console doctrine:fixtures:load --append --group=users
DEFAULT_USER_NAME="Administrador CBF"
DEFAULT_USER_EMAIL=admin@cbf.com.br
DEFAULT_USER_PASSWORD=cbf@2026
###< autenticação ###
