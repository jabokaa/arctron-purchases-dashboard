# Configuração do WooCommerce de DESENVOLVIMENTO (só para testar a integração; não use em produção)

# Endereço da loja no navegador
WOO_PORT=8081
WOO_URL=http://localhost:8081

# Login do wp-admin
WOO_ADMIN_USER=admin
WOO_ADMIN_PASSWORD=admin
WOO_ADMIN_EMAIL=admin@teste.com

# Webhook "Pedido criado" -> backend (nome do serviço do backend: a loja está no mesmo projeto do docker compose).
# O segredo TEM que ser igual ao WOOCOMMERCE_WEBHOOK_SECRET do backend/.env.
WOO_WEBHOOK_URL=http://backend:8000/api/webhooks/woocommerce
WOO_WEBHOOK_SECRET=dev-webhook-secret

# Banco da loja (MariaDB)
WOO_DB_NAME=wordpress
WOO_DB_USER=wordpress
WOO_DB_PASSWORD=wordpress
WOO_DB_ROOT_PASSWORD=root
